# react-day-picker@8.10.1 declara peer date-fns@^2.28.0 || ^3.0.0, pero el
# proyecto usa date-fns@4 (lo necesitan date-fns-tz y el resto del codigo).
# Sin esto, `npm install` falla con ERESOLVE tanto en local como en Vercel.
# Al actualizar react-day-picker a v9 (soporta date-fns 4) se puede quitar.
legacy-peer-deps=true
